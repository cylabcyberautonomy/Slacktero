# Copy this file to `.env` and fill in real values. Do not commit `.env`.

# Slack — from your app at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Zotero — API key with write access to the group, and the numeric group ID
ZOTERO_API_KEY=your-zotero-api-key
ZOTERO_GROUP_ID=1234567

# Logging — set to DEBUG for the per-add trace (URL -> translate -> upload -> react)
LOG_LEVEL=INFO
